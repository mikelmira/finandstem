# Fin & Stem — environment variables
# Copy to .env.local for local dev. In Vercel, set these in Project → Settings → Environment Variables.

# Public base URL. Drives canonical URLs, sitemap entries, OG tags, JSON-LD @id values.
# - Local dev:   http://localhost:3000
# - Vercel prod: https://finandstem.com
# - Vercel preview: leave unset (or use https://${VERCEL_URL}) — site.ts falls back to finandstem.com
NEXT_PUBLIC_SITE_URL=https://finandstem.com
